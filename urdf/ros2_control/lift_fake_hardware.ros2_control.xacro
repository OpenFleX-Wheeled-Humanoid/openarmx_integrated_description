<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Fake Hardware Interface for Lift (for simulation/testing) -->
  <ros2_control name="lift_fake_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="mock_sensor_commands">false</param>
      <!-- IMPORTANT: calculate_dynamics enables velocity integration -->
      <param name="calculate_dynamics">true</param>
      <param name="position_state_following_offset">0.0</param>
    </hardware>

    <joint name="plate_joint">
      <!-- Position interface -->
      <command_interface name="position">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <!-- Velocity interface -->
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>

</robot>
